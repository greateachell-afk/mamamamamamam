<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>실시간 멀티 마피아 게임</title>
  
  <style>
    :root {
      --bg-color: #0f172a;
      --panel-bg: #1e293b;
      --card-bg: #334155;
      --border-color: #475569;
      --text-main: #f8fafc;
      --text-muted: #cbd5e1;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --danger: #ef4444;
      --danger-hover: #dc2626;
      --success: #10b981;
      --warning: #f59e0b;
    }

    body.day-theme {
      --bg-color: #f1f5f9;
      --panel-bg: #ffffff;
      --card-bg: #f8fafc;
      --border-color: #cbd5e1;
      --text-main: #0f172a;
      --text-muted: #475569;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Pretendard", "Segoe UI", Roboto, sans-serif;
      user-select: none;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 24px;
      font-size: 18px;
      transition: background-color 0.4s ease, color 0.4s ease;
    }

    .container {
      width: 100%;
      max-width: 1024px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    header {
      background: var(--panel-bg);
      border: 2px solid var(--border-color);
      border-radius: 18px;
      padding: 20px 28px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.25);
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .title {
      font-size: 2.2rem;
      font-weight: 900;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, #60a5fa, #f43f5e);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .title-icons {
      font-size: 1.6rem;
      letter-spacing: 2px;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    }

    .badge {
      padding: 8px 18px;
      border-radius: 999px;
      font-size: 1rem;
      font-weight: 800;
    }
    .badge-lobby { background: #475569; color: #fff; }
    .badge-day { background: #fef08a; color: #854d0e; }
    .badge-night { background: #312e81; color: #c7d2fe; }

    .my-info-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--card-bg);
      padding: 12px 20px;
      border-radius: 12px;
      font-size: 1.1rem;
      border: 1.5px solid var(--border-color);
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      text-align: center;
      border-top: 2px dashed var(--border-color);
      padding-top: 14px;
    }
    .stat-label { font-size: 0.9rem; color: var(--text-muted); display: block; margin-bottom: 4px; }
    .stat-val { font-size: 1.3rem; font-weight: 800; }

    .panel {
      background: var(--panel-bg);
      border: 2px solid var(--border-color);
      border-radius: 18px;
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.25);
    }

    .panel-header {
      font-size: 1.3rem;
      font-weight: 800;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .banner {
      padding: 16px 20px;
      border-radius: 12px;
      font-size: 1.05rem;
      line-height: 1.5;
      background: rgba(59, 130, 246, 0.15);
      border-left: 6px solid var(--primary);
    }
    .banner.danger {
      background: rgba(239, 68, 68, 0.15);
      border-color: var(--danger);
    }

    .timer-display {
      font-size: 1.4rem;
      font-weight: 900;
      color: var(--warning);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    input[type="text"] {
      width: 100%;
      padding: 16px 20px;
      border-radius: 12px;
      border: 2px solid var(--border-color);
      outline: none;
      font-size: 1.1rem;
      background: var(--card-bg);
      color: var(--text-main);
    }
    input[type="text"]:focus { border-color: var(--primary); }

    button {
      cursor: pointer;
      border: none;
      border-radius: 12px;
      font-weight: 800;
      font-size: 1.1rem;
      padding: 16px 24px;
      transition: all 0.2s ease;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
    }
    button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      transform: none !important;
    }
    button:not(:disabled):active { transform: scale(0.98); }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:not(:disabled):hover { background: var(--primary-hover); }
    .btn-danger { background: var(--danger); color: white; }
    .btn-danger:not(:disabled):hover { background: var(--danger-hover); }
    .btn-outline {
      background: transparent;
      border: 2px solid var(--border-color);
      color: var(--text-main);
    }
    .btn-kick {
      background: var(--danger);
      color: white;
      font-size: 0.8rem;
      padding: 4px 8px;
      border-radius: 6px;
      margin-top: 4px;
    }
    .btn-block { width: 100%; padding: 18px; font-size: 1.2rem; }

    .player-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 16px;
    }

    .player-card {
      background: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 14px;
      padding: 16px 10px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      position: relative;
    }
    .player-card.selectable { 
      cursor: pointer !important;
      border-color: var(--primary);
    }
    .player-card.selectable:hover {
      transform: translateY(-3px);
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }
    .player-card.selected {
      border-color: var(--warning) !important;
      background: rgba(245, 158, 11, 0.25) !important;
      box-shadow: 0 0 16px rgba(245, 158, 11, 0.6) !important;
    }
    .player-card.dead {
      opacity: 0.75;
      filter: grayscale(80%);
      border-style: dashed;
      border-color: var(--danger);
    }
    .player-card.is-teammate {
      border-color: var(--danger);
      background: rgba(239, 68, 68, 0.15);
    }

    .avatar-icon { font-size: 2.4rem; }
    .player-name {
      font-size: 1rem;
      font-weight: 800;
      word-break: break-all;
    }
    .status-badge {
      font-size: 0.75rem;
      font-weight: 800;
      padding: 4px 8px;
      border-radius: 6px;
      margin-top: 2px;
    }

    .mafia-markers {
      display: flex;
      gap: 4px;
      flex-wrap: wrap;
      justify-content: center;
      min-height: 20px;
      margin-top: 4px;
    }
    .mafia-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 2px solid #fff;
      box-shadow: 0 0 4px rgba(0,0,0,0.5);
    }

    .secret-box {
      border: 3px dashed var(--border-color);
      border-radius: 16px;
      padding: 36px 20px;
      text-align: center;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      background: var(--card-bg);
      transition: background 0.2s;
    }
    .secret-box:hover { border-color: var(--primary); }
    .role-title { font-size: 2rem; font-weight: 900; }
    .role-mafia { color: #ef4444; }
    .role-police { color: #3b82f6; }
    .role-doctor { color: #10b981; }
    .role-priest { color: #f59e0b; }
    .role-sniper { color: #8b5cf6; }
    .role-citizen { color: #94a3b8; }

    .host-dashboard {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
    }
    .host-card {
      background: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 14px;
      padding: 18px 12px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 20px;
    }
    .modal-overlay.active { display: flex; }
    .modal-card {
      background: var(--panel-bg);
      border: 2px solid var(--border-color);
      border-radius: 20px;
      max-width: 580px;
      width: 100%;
      padding: 32px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .death-notice-card {
      background: rgba(239, 68, 68, 0.12);
      border: 3px dashed var(--danger);
      border-radius: 16px;
      padding: 20px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .action-report-card {
      background: rgba(59, 130, 246, 0.12);
      border: 3px dashed var(--primary);
      border-radius: 16px;
      padding: 20px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      text-align: left;
      width: 100%;
    }
    .death-name { font-size: 2.2rem; font-weight: 900; color: #ef4444; line-height: 1.1; }
    .death-role { font-size: 1.6rem; font-weight: 900; color: var(--warning); margin-top: 2px; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="header-top">
        <div class="title">
          <span>MAFIA ONLINE</span>
          <span class="title-icons">🕶️👮‍♂️💉✝️🎯</span>
        </div>
        <span id="phaseBadge" class="badge badge-lobby">대기실</span>
      </div>

      <div id="myInfoBar" class="my-info-bar" style="display: none;">
        <span>닉네임: <b id="myNicknameDisplay">-</b></span>
        <span>직업: <b id="myRoleDisplay">비공개</b></span>
      </div>

      <div class="stats-row" id="statsRow" style="display: none;">
        <div>
          <span class="stat-label">진행</span>
          <span class="stat-val" id="statDay">1일차</span>
        </div>
        <div>
          <span class="stat-label">생존자</span>
          <span class="stat-val" id="statAlive">0명</span>
        </div>
        <div>
          <span class="stat-label">사망자</span>
          <span class="stat-val" id="statDead">0명</span>
        </div>
        <div>
          <span class="stat-label">남은시간</span>
          <span class="stat-val" id="statTimer" style="color:var(--warning)">30초</span>
        </div>
      </div>
    </header>

    <section id="panelEntry" class="panel">
      <div class="panel-header">
        <span>게임 참가 / 방 만들기</span>
      </div>
      <div class="banner">
        모바일 또는 PC로 4자리 숫자 보안코드를 입력하여 실시간으로 함께 즐기세요!
      </div>

      <div class="input-group">
        <input type="text" id="inputNickname" placeholder="내 닉네임 입력 (최대 10자)" maxlength="10" />
      </div>

      <div style="display: flex; gap: 12px;">
        <button id="btnCreateRoom" class="btn-primary" style="flex: 1;">방 새로 만들기 (방장/관전)</button>
      </div>

      <div style="display: flex; align-items: center; gap: 12px; margin-top: 8px;">
        <input type="text" id="inputRoomCode" placeholder="4자리 숫자 보안코드 입력" maxlength="4" inputmode="numeric" />
        <button id="btnJoinRoom" class="btn-outline" style="white-space: nowrap;">플레이어로 입장</button>
      </div>
    </section>

    <section id="panelLobby" class="panel" style="display: none;">
      <div class="panel-header">
        <span>대기실 [ 보안코드: <span id="roomCodeDisplay" style="color:var(--primary); letter-spacing: 2px;">----</span> ]</span>
        <span id="lobbyPlayerCount" style="font-size:1rem; color:var(--text-muted)">0 / 5명 (최소 5명)</span>
      </div>
      <div class="banner">
        친구들에게 4자리 보안코드를 공유하세요! <b>의사, 경찰, 성직자, 저격수</b> 직업이 함께 포함됩니다.
      </div>

      <div class="player-grid" id="lobbyPlayerGrid"></div>

      <button id="btnStartGame" class="btn-primary btn-block" disabled style="display: none;">
        게임 시작하기 (최소 5명 필요)
      </button>
      <div id="waitHostNotice" style="text-align: center; font-size: 1rem; color: var(--text-muted); display: none;">
        방장이 게임을 시작하기를 기다리고 있습니다...
      </div>
    </section>

    <section id="panelRoleCheck" class="panel" style="display: none;">
      <div class="panel-header">
        <span>본인 직업 비밀 확인</span>
        <span id="roleCheckStatus" style="font-size:1rem; color:var(--primary)">0명 준비됨</span>
      </div>
      <div class="banner">
        카드를 터치하여 직업을 확인한 후, **다시 터치하여 숨길 수 있습니다.** 확인 후 아래 완료 버튼을 누르세요.
      </div>

      <div class="secret-box" id="secretBox">
        <span class="avatar-icon">🔒</span>
        <p style="font-size:1.2rem; font-weight: 800;">터치하여 직업 확인하기 (다시 터치하면 숨겨짐)</p>
      </div>

      <div id="unreadyListDisplay" style="font-size: 0.95rem; color: var(--warning); text-align: center; font-weight: 700; margin-top: 4px;"></div>

      <button id="btnConfirmRole" class="btn-primary btn-block" style="display: none;">
        확인 완료 (대기)
      </button>
    </section>

    <section id="panelDay" class="panel" style="display: none;">
      <div class="panel-header">
        <span>☀️ 낮 - 자유 토론 및 투표</span>
        <span class="timer-display">⏱️ <span id="dayTimerText">30</span>초</span>
      </div>
      <div id="dayAnnouncement" class="banner">
        자유롭게 토론을 나눈 뒤 처형할 대상 1명을 지목해 투표하세요. (30초 제한시간)
      </div>
      <div id="dayStatusGuide" style="font-weight:800; color:var(--primary); font-size:1.1rem;">
        처형할 용의자를 선택하세요:
      </div>

      <div class="player-grid" id="dayPlayerGrid"></div>

      <button id="btnSubmitDayVote" class="btn-danger btn-block" disabled>
        투표 제출
      </button>
      <button id="btnReturnToLobbyDay" class="btn-primary btn-block" style="display: none; background:var(--success);">
        🔄 대기실(로비)로 돌아가기
      </button>
    </section>

    <section id="panelNight" class="panel" style="display: none;">
      <div class="panel-header">
        <span>🌙 밤 - 비밀 행동 단계</span>
        <span id="nightRoleTitle" class="badge badge-night">행동 진행 중</span>
      </div>
      <div id="nightBanner" class="banner danger">
        밤이 되었습니다. 각 직업의 순서에 맞춰 비밀 능력을 사용하세요!
      </div>
      <div id="mafiaTeamNotice" class="banner" style="display: none; background: rgba(239, 68, 68, 0.2); border-color: var(--danger);"></div>
      <div id="nightGuideText" style="font-weight:800; font-size:1.1rem;"></div>

      <div class="player-grid" id="nightPlayerGrid"></div>

      <div style="display: flex; gap: 12px; width: 100%;">
        <button id="btnSkipNightAction" class="btn-outline" style="flex: 1; display: none;">
          턴 넘기기 (스킵)
        </button>
        <button id="btnSubmitNightAction" class="btn-danger btn-block" style="flex: 2;" disabled>
          행동 완료
        </button>
      </div>
    </section>

    <section id="panelHostView" class="panel" style="display: none;">
      <div class="panel-header">
        <span>🖥️ 방장 중앙 관전 통제판</span>
        <span id="hostStatusBadge" class="badge badge-lobby">진행 상황 실시간 생중계</span>
      </div>
      <div class="banner">
        방장은 생존 중인 사람들의 직업을 볼 수 없습니다. (사망자의 직업도 투명하게 공개)
      </div>
      <div class="host-dashboard" id="hostDashboardGrid"></div>
      <button id="btnReturnToLobbyHost" class="btn-primary btn-block" style="display: none; background:var(--success);">
        🔄 대기실(로비)로 모두 돌아가기
      </button>
    </section>
  </div>

  <div class="modal-overlay" id="commonModal">
    <div class="modal-card">
      <h2 id="modalTitle" style="font-size: 1.6rem;">알림</h2>
      <div id="modalBody" style="font-size: 1.1rem; line-height: 1.5; color: var(--text-main);"></div>
      <button id="btnModalClose" class="btn-primary btn-block">확인</button>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import { getDatabase, ref, set, get, update, onValue, remove } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyAwK3_AfJXdhE8DPoWdX6QG9LWiK3zNOlc",
      authDomain: "mafi-b699e.firebaseapp.com",
      databaseURL: "https://mafi-b699e-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "mafi-b699e",
      storageBucket: "mafi-b699e.firebasestorage.app",
      messagingSenderId: "46754763306",
      appId: "1:46754763306:web:66ac5ced6b5789c4b5a953"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    const ROLES = {
      MAFIA: '마피아',
      DOCTOR: '의사',
      POLICE: '경찰',
      PRIEST: '성직자',
      SNIPER: '저격수',
      CITIZEN: '시민'
    };

    const MAFIA_COLORS = ['#ef4444', '#f59e0b', '#ec4899', '#8b5cf6'];
    const NIGHT_STEPS = ['MAFIA', 'POLICE', 'DOCTOR', 'PRIEST', 'SNIPER'];

    const clientState = {
      roomCode: null,
      myPlayerId: null,
      myNickname: null,
      myRole: null,
      myMafiaColor: '#ef4444',
      isHost: false,
      isAlive: true,
      currentRoomData: null,
      selectedDayTargetId: null,
      selectedNightTargetId: null,
      hasVotedDay: false,
      hasActedNight: false,
      isSubmitting: false
    };

    let localTimerInterval = null;
    let lastNotifiedEventId = null;
    let lastNotifiedEndGameId = null;
    let isRendering = false; // 병목(연속 렌더링) 차단 가드

    function playChimeSound() {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const now = audioCtx.currentTime;
        [523.25, 392.00, 329.63].forEach((freq, idx) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + idx * 0.2);
          gain.gain.setValueAtTime(0.3, now + idx * 0.2);
          gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.2 + 0.8);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now + idx * 0.2);
          osc.stop(now + idx * 0.2 + 0.8);
        });
      } catch (e) {}
    }

    const body = document.body;
    const phaseBadge = document.getElementById('phaseBadge');
    const myInfoBar = document.getElementById('myInfoBar');
    const myNicknameDisplay = document.getElementById('myNicknameDisplay');
    const myRoleDisplay = document.getElementById('myRoleDisplay');
    const statsRow = document.getElementById('statsRow');
    const statDay = document.getElementById('statDay');
    const statAlive = document.getElementById('statAlive');
    const statDead = document.getElementById('statDead');
    const statTimer = document.getElementById('statTimer');
    const dayTimerText = document.getElementById('dayTimerText');

    const panelEntry = document.getElementById('panelEntry');
    const panelLobby = document.getElementById('panelLobby');
    const panelRoleCheck = document.getElementById('panelRoleCheck');
    const panelDay = document.getElementById('panelDay');
    const panelNight = document.getElementById('panelNight');
    const panelHostView = document.getElementById('panelHostView');
    const hostDashboardGrid = document.getElementById('hostDashboardGrid');

    const inputNickname = document.getElementById('inputNickname');
    const inputRoomCode = document.getElementById('inputRoomCode');
    const btnCreateRoom = document.getElementById('btnCreateRoom');
    const btnJoinRoom = document.getElementById('btnJoinRoom');
    const roomCodeDisplay = document.getElementById('roomCodeDisplay');
    const lobbyPlayerCount = document.getElementById('lobbyPlayerCount');
    const lobbyPlayerGrid = document.getElementById('lobbyPlayerGrid');
    const btnStartGame = document.getElementById('btnStartGame');
    const waitHostNotice = document.getElementById('waitHostNotice');

    const roleCheckStatus = document.getElementById('roleCheckStatus');
    const secretBox = document.getElementById('secretBox');
    const unreadyListDisplay = document.getElementById('unreadyListDisplay');
    const btnConfirmRole = document.getElementById('btnConfirmRole');

    const dayAnnouncement = document.getElementById('dayAnnouncement');
    const dayStatusGuide = document.getElementById('dayStatusGuide');
    const dayPlayerGrid = document.getElementById('dayPlayerGrid');
    const btnSubmitDayVote = document.getElementById('btnSubmitDayVote');
    const btnReturnToLobbyDay = document.getElementById('btnReturnToLobbyDay');
    const btnReturnToLobbyHost = document.getElementById('btnReturnToLobbyHost');

    const nightRoleTitle = document.getElementById('nightRoleTitle');
    const nightBanner = document.getElementById('nightBanner');
    const mafiaTeamNotice = document.getElementById('mafiaTeamNotice');
    const nightGuideText = document.getElementById('nightGuideText');
    const nightPlayerGrid = document.getElementById('nightPlayerGrid');
    const btnSubmitNightAction = document.getElementById('btnSubmitNightAction');
    const btnSkipNightAction = document.getElementById('btnSkipNightAction');

    const commonModal = document.getElementById('commonModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalBody = document.getElementById('modalBody');
    const btnModalClose = document.getElementById('btnModalClose');
    let modalCallback = null;

    function showModal(title, textHtml, cb = null) {
      modalTitle.textContent = title;
      modalBody.innerHTML = textHtml;
      modalCallback = cb;
      commonModal.classList.add('active');
    }
    btnModalClose.addEventListener('click', () => {
      commonModal.classList.remove('active');
      if (typeof modalCallback === 'function') {
        const c = modalCallback;
        modalCallback = null;
        c();
      }
    });

    function generateRoomCode() {
      let code = '';
      for (let i = 0; i < 4; i++) {
        code += Math.floor(Math.random() * 10);
      }
      return code;
    }

    btnCreateRoom.addEventListener('click', async () => {
      if (clientState.isSubmitting) return;
      const nickname = inputNickname.value.trim() || '방장(관전)';

      clientState.isSubmitting = true;
      btnCreateRoom.disabled = true;

      const roomCode = generateRoomCode();
      const myId = 'host_' + Date.now();

      try {
        await set(ref(db, `rooms/${roomCode}`), {
          roomCode: roomCode,
          hostId: myId,
          status: 'LOBBY',
          dayCount: 1,
          createdAt: Date.now(),
          players: {}
        });

        initClientSession(roomCode, myId, nickname, true);
      } catch (err) {
        showModal('오류', '방 생성 에러: ' + err.message);
      } finally {
        clientState.isSubmitting = false;
        btnCreateRoom.disabled = false;
      }
    });

    btnJoinRoom.addEventListener('click', async () => {
      if (clientState.isSubmitting) return;
      const nickname = inputNickname.value.trim();
      const code = inputRoomCode.value.trim();

      if (!nickname) return showModal('알림', '닉네임을 입력해 주세요.');
      if (!code || code.length !== 4) return showModal('알림', '올바른 4자리 숫자 보안코드를 입력해 주세요.');

      clientState.isSubmitting = true;
      btnJoinRoom.disabled = true;

      try {
        const roomSnapshot = await get(ref(db, `rooms/${code}`));
        if (!roomSnapshot.exists()) {
          showModal('입장 실패', '존재하지 않는 보안코드입니다.');
          return;
        }

        const roomData = roomSnapshot.val();
        if (roomData.status !== 'LOBBY') {
          showModal('입장 불가', '이미 게임이 진행 중인 방입니다.');
          return;
        }

        const existingPlayers = Object.values(roomData.players || {});
        if (existingPlayers.some(p => p.name.toLowerCase() === nickname.toLowerCase())) {
          showModal('중복 닉네임', `[${nickname}] 은(는) 해당 방에 이미 존재하는 닉네임입니다.`);
          return;
        }

        const myId = 'p_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6);
        await set(ref(db, `rooms/${code}/players/${myId}`), {
          id: myId,
          name: nickname,
          role: null,
          isAlive: true,
          deadReason: '',
          readyCheck: false
        });

        initClientSession(code, myId, nickname, false);
      } catch (err) {
        showModal('오류', '입장 처리 에러: ' + err.message);
      } finally {
        clientState.isSubmitting = false;
        btnJoinRoom.disabled = false;
      }
    });

    function initClientSession(roomCode, myId, nickname, isHost) {
      clientState.roomCode = roomCode;
      clientState.myPlayerId = myId;
      clientState.myNickname = nickname;
      clientState.isHost = isHost;

      panelEntry.style.display = 'none';
      panelLobby.style.display = 'flex';
      myInfoBar.style.display = 'flex';
      myNicknameDisplay.textContent = isHost ? `${nickname} (진행자)` : nickname;
      myRoleDisplay.textContent = isHost ? '관전자(방장)' : '확인 완료 (비공개)';
      roomCodeDisplay.textContent = roomCode;

      listenToRoomData(roomCode);
    }

    function listenToRoomData(roomCode) {
      const roomRef = ref(db, `rooms/${roomCode}`);
      onValue(roomRef, (snapshot) => {
        if (!snapshot.exists()) return;
        const data = snapshot.val();
        clientState.currentRoomData = data;

        if (!clientState.isHost) {
          const me = data.players ? data.players[clientState.myPlayerId] : null;
          if (!me) {
            alert('방장에 의해 강퇴되었습니다.');
            window.location.reload();
            return;
          }
          clientState.myRole = me.role;
          clientState.isAlive = me.isAlive;
          
          if (data.status !== 'ROLE_CHECK' && data.status !== 'LOBBY') {
            myRoleDisplay.textContent = clientState.isAlive ? '비공개 (보안 유지)' : '사망';
          } else if (me.role) {
            myRoleDisplay.textContent = me.role;
          }

          if (me.role === ROLES.MAFIA) {
            const mafiaList = Object.values(data.players || {}).filter(p => p.role === ROLES.MAFIA);
            const mIndex = mafiaList.findIndex(p => p.id === clientState.myPlayerId);
            clientState.myMafiaColor = MAFIA_COLORS[mIndex % MAFIA_COLORS.length];
          }
        }

        clientState.isHost = (data.hostId === clientState.myPlayerId);
        renderDashboard(data);

        // 팝업 이벤트 중복 방지 가드 (병목 방지 핵심)
        if (data.latestGameEvent && data.latestGameEvent.id !== lastNotifiedEventId) {
          lastNotifiedEventId = data.latestGameEvent.id;
          playChimeSound();
          if (data.latestGameEvent.type === 'MORNING_REPORT') {
            const ev = data.latestGameEvent;
            let deathHtml = `<div class="death-notice-card"><span class="avatar-icon">✨</span><div style="font-size:1.4rem; font-weight:900; color:var(--success);">평화로운 아침</div><div style="font-size:1.05rem;">아무도 사망하지 않았습니다.</div></div>`;
            if (ev.deadName) {
              deathHtml = `
                <div class="death-notice-card">
                  <span class="avatar-icon">💀</span>
                  <div>
                    <div class="death-name">${ev.deadName} 님</div>
                    <div class="death-role">${ev.deadRole}</div>
                  </div>
                  <div style="font-size:1.05rem; font-weight:800; color:var(--text-main);">사망 사유: <span style="color:var(--danger);">${ev.deadReason}</span></div>
                </div>
              `;
            }

            showModal('📢 아침 종합 리포트 & 사망 공지', `
              <div style="display:flex; flex-direction:column; gap:14px; text-align:left;">
                ${deathHtml}
                <div class="action-report-card">
                  <span style="font-weight:900; font-size:1.15rem; color:var(--primary);">🌙 밤 사이 주요 사건 결과</span>
                  <div style="font-size:1.05rem; line-height:1.6; font-weight:700;">
                    ${ev.actionReportText || '특이 사항 없음'}
                  </div>
                </div>
              </div>
            `);
          }
        }

        if (data.status === 'END' && data.gameOverInfo && data.gameOverInfo.id !== lastNotifiedEndGameId) {
          lastNotifiedEndGameId = data.gameOverInfo.id;
          playChimeSound();
          showModal('🎉 최종 게임 결과', `
            <div style="display:flex; flex-direction:column; gap:16px; text-align:center;">
              <div style="font-size:1.8rem; font-weight:900; color:var(--warning);">
                🏆 ${data.gameOverInfo.winnerTitle}
              </div>
              <div style="font-size:1.1rem; line-height:1.5; background:rgba(59,130,246,0.1); padding:14px; border-radius:12px;">
                ${data.gameOverInfo.desc}
              </div>
              <div style="background:var(--card-bg); padding:16px; border-radius:12px; border:1px solid var(--border-color);">
                <div style="font-weight:800; font-size:1.1rem; margin-bottom:8px; color:var(--success);">🛡️ 최종 생존자 명단</div>
                <div style="font-size:1.05rem; font-weight:700; color:var(--text-main);">
                  ${data.gameOverInfo.survivorsText}
                </div>
              </div>
            </div>
          `);
        }

        if (clientState.isHost && data.status !== 'LOBBY') {
          renderHostDashboard(data);
          panelHostView.style.display = 'flex';
        } else {
          panelHostView.style.display = 'none';
        }

        // requestAnimationFrame으로 화면 렌더링 부드럽게 예약 (병목 제거)
        if (!isRendering) {
          isRendering = true;
          requestAnimationFrame(() => {
            switch (data.status) {
              case 'LOBBY': handleLobbySync(data); break;
              case 'ROLE_CHECK': handleRoleCheckSync(data); break;
              case 'DAY': handleDaySync(data); break;
              case 'NIGHT': handleNightSync(data); break;
              case 'END': handleEndSync(data); break;
            }
            isRendering = false;
          });
        }
      });
    }

    function renderDashboard(data) {
      const players = Object.values(data.players || {});
      const aliveCount = players.filter(p => p.isAlive).length;
      const deadCount = players.filter(p => !p.isAlive).length;

      if (data.status !== 'LOBBY') {
        statsRow.style.display = 'grid';
        statDay.textContent = `${data.dayCount || 1}일차`;
        statAlive.textContent = `${aliveCount}명`;
        statDead.textContent = `${deadCount}명`;
      } else {
        statsRow.style.display = 'none';
      }
    }

    function renderHostDashboard(data) {
      const players = Object.values(data.players || {});
      hostDashboardGrid.innerHTML = '';

      players.forEach(p => {
        const card = document.createElement('div');
        card.className = `host-card ${!p.isAlive ? 'dead' : ''}`;
        const displayedRole = p.isAlive ? '❓ 미공개 (생존)' : `${p.role} (사망)`;

        card.innerHTML = `
          <span class="avatar-icon">${!p.isAlive ? '👼' : '👤'}</span>
          <span class="player-name">${p.name}</span>
          <span style="font-weight:900; color:var(--primary); font-size:0.95rem;">${displayedRole}</span>
          <span class="status-badge" style="background:${p.isAlive ? 'rgba(16,185,129,0.2)' : 'rgba(239,68,68,0.2)'}">
            ${p.isAlive ? '생존' : '사망 (' + p.deadReason + ')'}
          </span>
        `;
        hostDashboardGrid.appendChild(card);
      });

      if (data.status === 'END') {
        btnReturnToLobbyHost.style.display = 'block';
      } else {
        btnReturnToLobbyHost.style.display = 'none';
      }
    }

    function handleLobbySync(data) {
      phaseBadge.textContent = '대기실';
      phaseBadge.className = 'badge badge-lobby';

      const players = Object.values(data.players || {});
      lobbyPlayerCount.textContent = `${players.length}명 참가 중 (최소 5명 필요)`;

      lobbyPlayerGrid.innerHTML = '';
      players.forEach(p => {
        const card = document.createElement('div');
        card.className = 'player-card';
        card.innerHTML = `
          <span class="avatar-icon">👤</span>
          <span class="player-name">${p.name}</span>
          ${clientState.isHost ? `<button class="btn-kick" data-id="${p.id}">❌ 강퇴</button>` : ''}
        `;
        lobbyPlayerGrid.appendChild(card);
      });

      if (clientState.isHost) {
        document.querySelectorAll('.btn-kick').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const targetId = e.target.getAttribute('data-id');
            await remove(ref(db, `rooms/${clientState.roomCode}/players/${targetId}`));
          });
        });

        btnStartGame.style.display = 'block';
        waitHostNotice.style.display = 'none';
        btnStartGame.disabled = players.length < 5;
        btnStartGame.textContent = players.length < 5 
          ? `게임 시작 (${players.length}/5명)` 
          : `총 ${players.length}명으로 게임 시작!`;
      } else {
        btnStartGame.style.display = 'none';
        waitHostNotice.style.display = 'block';
      }
    }

    btnStartGame.addEventListener('click', async () => {
      const data = clientState.currentRoomData;
      if (!data || !clientState.isHost) return;

      const players = Object.values(data.players || {});
      const n = players.length;
      if (n < 5) return;

      let mafiaCount = 1;
      if (n >= 7 && n <= 9) mafiaCount = 2;
      else if (n >= 10) mafiaCount = 3;

      let rolesPool = [];
      for (let i = 0; i < mafiaCount; i++) rolesPool.push(ROLES.MAFIA);
      rolesPool.push(ROLES.POLICE);
      rolesPool.push(ROLES.DOCTOR);
      rolesPool.push(ROLES.PRIEST);
      rolesPool.push(ROLES.SNIPER);

      while(rolesPool.length < n) rolesPool.push(ROLES.CITIZEN);

      for (let i = rolesPool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [rolesPool[i], rolesPool[j]] = [rolesPool[j], rolesPool[i]];
      }

      const updates = {};
      players.forEach((p, idx) => {
        updates[`rooms/${clientState.roomCode}/players/${p.id}/role`] = rolesPool[idx];
        updates[`rooms/${clientState.roomCode}/players/${p.id}/isAlive`] = true;
        updates[`rooms/${clientState.roomCode}/players/${p.id}/deadReason`] = '';
        updates[`rooms/${clientState.roomCode}/players/${p.id}/readyCheck`] = false;
      });
      updates[`rooms/${clientState.roomCode}/status`] = 'ROLE_CHECK';
      updates[`rooms/${clientState.roomCode}/dayCount`] = 1;
      updates[`rooms/${clientState.roomCode}/dayVotes`] = null;
      updates[`rooms/${clientState.roomCode}/nightActions`] = null;
      updates[`rooms/${clientState.roomCode}/nightStep`] = 'MAFIA';
      updates[`rooms/${clientState.roomCode}/latestGameEvent`] = null;
      updates[`rooms/${clientState.roomCode}/gameOverInfo`] = null;

      await update(ref(db), updates);
    });

    function handleRoleCheckSync(data) {
      panelLobby.style.display = 'none';
      if (!clientState.isHost) panelRoleCheck.style.display = 'flex';
      
      phaseBadge.textContent = '직업 확인 단계';
      phaseBadge.className = 'badge badge-lobby';

      const players = Object.values(data.players || {});
      const readyCount = players.filter(p => p.readyCheck).length;
      roleCheckStatus.textContent = `${readyCount} / ${players.length}명 확인 완료`;

      const unreadyPlayers = players.filter(p => !p.readyCheck).map(p => p.name);
      if (unreadyPlayers.length > 0) {
        unreadyListDisplay.textContent = `⏳ 아직 확인을 안 누른 사람: ${unreadyPlayers.join(', ')}`;
      } else {
        unreadyListDisplay.textContent = '✨ 전원 확인 완료!';
      }

      if (clientState.isHost && readyCount === players.length && players.length > 0) {
        setTimeout(async () => {
          await update(ref(db, `rooms/${clientState.roomCode}`), {
            status: 'DAY',
            dayAnnouncement: '첫 번째 낮이 밝았습니다. 30초 동안 토론 후 투표하세요.',
            timerEndTime: Date.now() + 30000
          });
        }, 600);
      }
    }

    let isRoleRevealed = false;
    secretBox.addEventListener('click', () => {
      if (!clientState.myRole) return;

      if (!isRoleRevealed) {
        isRoleRevealed = true;
        let icon = '🧑‍🌾';
        let cls = 'role-citizen';
        if (clientState.myRole === ROLES.MAFIA) { icon = '🕶️'; cls = 'role-mafia'; }
        else if (clientState.myRole === ROLES.DOCTOR) { icon = '💉'; cls = 'role-doctor'; }
        else if (clientState.myRole === ROLES.POLICE) { icon = '👮‍♂️'; cls = 'role-police'; }
        else if (clientState.myRole === ROLES.PRIEST) { icon = '✝️'; cls = 'role-priest'; }
        else if (clientState.myRole === ROLES.SNIPER) { icon = '🎯'; cls = 'role-sniper'; }

        secretBox.innerHTML = `
          <span class="avatar-icon">${icon}</span>
          <div class="role-title ${cls}">${clientState.myRole}</div>
          <p style="font-size:1rem; color:var(--text-muted)">⚠️ 다시 터치하면 카드가 숨겨집니다!</p>
        `;
        btnConfirmRole.style.display = 'block';
      } else {
        isRoleRevealed = false;
        secretBox.innerHTML = `
          <span class="avatar-icon">🔒</span>
          <p style="font-size:1.2rem; font-weight: 800;">터치하여 직업 확인하기 (다시 터치하면 숨겨짐)</p>
        `;
      }
    });

    btnConfirmRole.addEventListener('click', async () => {
      btnConfirmRole.disabled = true;
      btnConfirmRole.textContent = '다른 플레이어 대기 중...';
      await update(ref(db, `rooms/${clientState.roomCode}/players/${clientState.myPlayerId}`), {
        readyCheck: true
      });
    });

    function handleDaySync(data) {
      body.classList.add('day-theme');
      panelRoleCheck.style.display = 'none';
      panelNight.style.display = 'none';
      if (!clientState.isHost) panelDay.style.display = 'flex';

      phaseBadge.textContent = '☀️ 낮 (토론/투표)';
      phaseBadge.className = 'badge badge-day';

      if (data.dayAnnouncement) {
        dayAnnouncement.innerHTML = data.dayAnnouncement;
      }

      const players = Object.values(data.players || {});
      const alivePlayers = players.filter(p => p.isAlive);
      const dayVotes = data.dayVotes || {};

      clientState.hasVotedDay = !!dayVotes[clientState.myPlayerId];
      if (!clientState.isAlive) {
        dayStatusGuide.innerHTML = '👼 당신은 <strong style="color:var(--danger)">사망</strong>하여 관전 모드입니다.';
        btnSubmitDayVote.disabled = true;
      } else if (clientState.hasVotedDay) {
        dayStatusGuide.innerHTML = '✅ 투표 완료! 다른 생존자들의 투표를 기다리고 있습니다...';
        btnSubmitDayVote.disabled = true;
      } else {
        dayStatusGuide.innerHTML = '처형할 용의자를 선택하세요 (30초 제한):';
      }

      renderDayGrid(players);

      if (data.timerEndTime) {
        clearInterval(localTimerInterval);
        localTimerInterval = setInterval(() => {
          const remain = Math.max(0, Math.ceil((data.timerEndTime - Date.now()) / 1000));
          dayTimerText.textContent = remain;
          statTimer.textContent = `${remain}초`;

          if (remain <= 0) {
            clearInterval(localTimerInterval);
            if (clientState.isHost) {
              autoCompleteDayVotesAndConclude(data);
            }
          }
        }, 500);
      }

      const voteCount = Object.keys(dayVotes).length;
      if (clientState.isHost && voteCount >= alivePlayers.length && alivePlayers.length > 0) {
        clearInterval(localTimerInterval);
        concludeDayVoting(data, dayVotes);
      }
    }

    function renderDayGrid(players) {
      dayPlayerGrid.innerHTML = '';
      players.forEach(p => {
        const card = document.createElement('div');
        const canSelect = clientState.isAlive && !clientState.hasVotedDay && p.isAlive;
        card.className = `player-card ${!p.isAlive ? 'dead' : ''} ${canSelect ? 'selectable' : ''}`;

        if (clientState.selectedDayTargetId === p.id) {
          card.classList.add('selected');
        }

        let statusHtml = `<span class="status-badge" style="background:rgba(16,185,129,0.2); color:var(--success);">생존</span>`;
        if (!p.isAlive) {
          const reasonText = p.deadReason ? `사망 (${p.deadReason})` : '사망';
          statusHtml = `<span class="status-badge" style="background:rgba(239,68,68,0.25); color:var(--danger);">${reasonText}</span>`;
        }

        card.innerHTML = `
          <span class="avatar-icon">${!p.isAlive ? '👼' : '👤'}</span>
          <span class="player-name">${p.name}</span>
          ${statusHtml}
        `;

        if (canSelect) {
          card.addEventListener('click', () => {
            clientState.selectedDayTargetId = p.id;
            btnSubmitDayVote.disabled = false;
            renderDayGrid(players);
          });
        }
        dayPlayerGrid.appendChild(card);
      });
    }

    btnSubmitDayVote.addEventListener('click', async () => {
      const targetId = clientState.selectedDayTargetId;
      if (!targetId || clientState.hasVotedDay || !clientState.isAlive) return;

      btnSubmitDayVote.disabled = true;
      await update(ref(db, `rooms/${clientState.roomCode}/dayVotes`), {
        [clientState.myPlayerId]: targetId
      });
    });

    async function autoCompleteDayVotesAndConclude(data) {
      const players = Object.values(data.players || {});
      const alivePlayers = players.filter(p => p.isAlive);
      const currentVotes = data.dayVotes || {};

      alivePlayers.forEach(p => {
        if (!currentVotes[p.id]) {
          const randomTarget = alivePlayers[Math.floor(Math.random() * alivePlayers.length)];
          currentVotes[p.id] = randomTarget.id;
        }
      });

      await concludeDayVoting(data, currentVotes);
    }

    async function concludeDayVoting(data, votes) {
      const voteCounts = {};
      Object.values(votes).forEach(tId => {
        voteCounts[tId] = (voteCounts[tId] || 0) + 1;
      });

      let maxVotes = -1;
      let targetIdWithMax = null;
      let isTie = false;

      for (const [tId, cnt] of Object.entries(voteCounts)) {
        if (cnt > maxVotes) {
          maxVotes = cnt;
          targetIdWithMax = tId;
          isTie = false;
        } else if (cnt === maxVotes) {
          isTie = true;
        }
      }

      const players = data.players || {};
      let announcement = '';

      if (isTie || !targetIdWithMax) {
        announcement = '투표 동률로 인해 아무도 처형되지 않고 밤이 되었습니다.';
      } else {
        const victim = players[targetIdWithMax];
        if (victim) {
          await update(ref(db, `rooms/${clientState.roomCode}/players/${victim.id}`), {
            isAlive: false,
            deadReason: '낮 투표 처형'
          });

          await update(ref(db, `rooms/${clientState.roomCode}`), {
            latestGameEvent: {
              id: 'event_' + Date.now(),
              type: 'MORNING_REPORT',
              deadName: victim.name,
              deadRole: victim.role,
              deadReason: '낮 투표 처형',
              actionReportText: '낮 투표로 인해 처형되었습니다.'
            }
          });

          announcement = `⚖️ 투표 결과, <b>${victim.name}</b>님이 처형되었습니다!`;
        }
      }

      if (checkWinCondition(data, targetIdWithMax)) return;

      await update(ref(db, `rooms/${clientState.roomCode}`), {
        status: 'NIGHT',
        nightStep: 'MAFIA',
        dayAnnouncement: announcement,
        dayVotes: null,
        nightActions: null
      });
    }

    function handleNightSync(data) {
      body.classList.remove('day-theme');
      panelDay.style.display = 'none';
      if (!clientState.isHost) panelNight.style.display = 'flex';

      phaseBadge.textContent = '🌙 밤 (순차적 비밀 행동)';
      phaseBadge.className = 'badge badge-night';

      const currentStep = data.nightStep || 'MAFIA';
      const nightActions = data.nightActions || {};
      const players = Object.values(data.players || {});
      const role = clientState.myRole;

      clientState.selectedNightTargetId = null;
      btnSkipNightAction.style.display = 'none';
      mafiaTeamNotice.style.display = 'none';

      let isMyTurnToAct = false;

      if (!clientState.isAlive) {
        nightRoleTitle.textContent = '관전 중';
        nightBanner.innerHTML = '👼 사망하여 밤 행동에 참여할 수 없습니다.';
        nightGuideText.innerHTML = '관전 모드로 다른 플레이어들의 턴 진행을 지켜보고 있습니다.';
        btnSubmitNightAction.style.display = 'none';
      } else {
        if (currentStep === 'MAFIA') {
          nightRoleTitle.textContent = '1단계: 마피아 턴';
          nightBanner.innerHTML = '🔫 <b>마피아가 습격할 사람을 고르고 있습니다.</b> 동료들과 합의하여 대상을 지목하세요.';
          if (role === ROLES.MAFIA) {
            isMyTurnToAct = true;
            const mafiaTeam = players.filter(p => p.role === ROLES.MAFIA).map(p => p.name).join(', ');
            mafiaTeamNotice.style.display = 'block';
            mafiaTeamNotice.innerHTML = `🕶️ <b>마피아 팀:</b> [ ${mafiaTeam} ]<br>💡 카드를 누르면 동료들에게 타겟 실시간 마커가 공유됩니다!`;
          } else {
            nightGuideText.innerHTML = `😴 현재 마피아 팀이 습격 대상을 고르는 중입니다... (내 직업: ${role})`;
          }
        } else if (currentStep === 'POLICE') {
          nightRoleTitle.textContent = '2단계: 경찰 턴';
          nightBanner.innerHTML = '👮‍♂️ <b>경찰이 조사 중입니다.</b> 의심되는 플레이어 한 명을 지목해 마피아 여부를 확인하세요.';
          if (role === ROLES.POLICE) {
            isMyTurnToAct = true;
          } else {
            nightGuideText.innerHTML = `😴 현재 경찰이 수사를 진행하는 중입니다... (내 직업: ${role})`;
          }
        } else if (currentStep === 'DOCTOR') {
          nightRoleTitle.textContent = '3단계: 의사 턴';
          nightBanner.innerHTML = '💉 <b>의사가 치료 중입니다.</b> 마피아의 습격으로부터 지켜낼 플레이어를 선택하세요.';
          if (role === ROLES.DOCTOR) {
            isMyTurnToAct = true;
          } else {
            nightGuideText.innerHTML = `😴 현재 의사가 치료 대상을 고민 중입니다... (내 직업: ${role})`;
          }
        } else if (currentStep === 'PRIEST') {
          nightRoleTitle.textContent = '4단계: 성직자 턴';
          nightBanner.innerHTML = '✝️ <b>성직자가 기도 중입니다.</b> 무덤 속 사망자를 구원하거나 턴을 넘기세요.';
          if (role === ROLES.PRIEST) {
            isMyTurnToAct = true;
            btnSkipNightAction.style.display = 'block';
          } else {
            nightGuideText.innerHTML = `😴 현재 성직자가 부활 기도를 올리는 중입니다... (내 직업: ${role})`;
          }
        } else if (currentStep === 'SNIPER') {
          nightRoleTitle.textContent = '5단계: 저격수 턴';
          nightBanner.innerHTML = '🎯 <b>저격수가 목표물을 찾는 중입니다.</b> 과감하게 저격하거나 턴을 넘기세요.';
          if (role === ROLES.SNIPER) {
            isMyTurnToAct = true;
            btnSkipNightAction.style.display = 'block';
          } else {
            nightGuideText.innerHTML = `😴 현재 저격수가 목표를 조준 중입니다... (내 직업: ${role})`;
          }
        }

        if (isMyTurnToAct) {
          nightGuideText.innerHTML = `✨ **당신의 턴입니다!** 행동할 대상을 아래에서 선택하거나 [턴 넘기기]를 누르세요.`;
          btnSubmitNightAction.style.display = 'block';
          btnSubmitNightAction.disabled = true;
        } else {
          btnSubmitNightAction.style.display = 'none';
        }
      }

      renderNightGrid(data.players, nightActions, currentStep, isMyTurnToAct);

      if (clientState.isHost) {
        checkAndAdvanceNightStep(data);
      }
    }

    function renderNightGrid(playersObj, nightActions, currentStep, isMyTurnToAct) {
      const players = Object.values(playersObj || {});
      nightPlayerGrid.innerHTML = '';

      players.forEach(p => {
        const card = document.createElement('div');
        const isSelfMafia = (clientState.myRole === ROLES.MAFIA);
        const isTargetMafia = (p.role === ROLES.MAFIA);
        
        let canSelect = false;
        if (clientState.isAlive && isMyTurnToAct) {
          if (currentStep === 'PRIEST') {
            canSelect = !p.isAlive;
          } else if (currentStep === 'SNIPER') {
            canSelect = p.isAlive && p.id !== clientState.myPlayerId;
          } else if (currentStep === 'MAFIA') {
            canSelect = p.isAlive && !(isSelfMafia && isTargetMafia);
          } else {
            canSelect = p.isAlive;
          }
        }

        let statusHtml = `<span class="status-badge" style="background:rgba(16,185,129,0.2); color:var(--success);">생존</span>`;
        if (!p.isAlive) {
          const reasonText = p.deadReason ? `사망 (${p.deadReason})` : '사망';
          statusHtml = `<span class="status-badge" style="background:rgba(239,68,68,0.25); color:var(--danger);">${reasonText}</span>`;
        }

        card.className = `player-card ${!p.isAlive ? 'dead' : ''} ${canSelect ? 'selectable' : ''} ${(isSelfMafia && isTargetMafia && currentStep === 'MAFIA') ? 'is-teammate' : ''}`;

        if (clientState.selectedNightTargetId === p.id) {
          card.classList.add('selected');
        }

        let markersHtml = '';
        if (isSelfMafia && currentStep === 'MAFIA') {
          const mafiaList = players.filter(x => x.role === ROLES.MAFIA);
          let mDots = '';
          mafiaList.forEach((m, idx) => {
            const targetChoice = nightActions[m.id];
            if (targetChoice === p.id) {
              const mColor = MAFIA_COLORS[idx % MAFIA_COLORS.length];
              mDots += `<div class="mafia-dot" style="background-color: ${mColor};" title="${m.name}의 선택"></div>`;
            }
          });
          if (mDots) {
            markersHtml = `<div class="mafia-markers">${mDots}</div>`;
          }
        }

        card.innerHTML = `
          <span class="avatar-icon">${!p.isAlive ? '👼' : '👤'}</span>
          <span class="player-name">${p.name}</span>
          ${statusHtml}
          ${(isSelfMafia && isTargetMafia && currentStep === 'MAFIA') ? '<span class="status-badge" style="background:rgba(239,68,68,0.3)">마피아 동료</span>' : ''}
          ${markersHtml}
        `;

        if (canSelect) {
          card.addEventListener('click', async () => {
            clientState.selectedNightTargetId = p.id;
            btnSubmitNightAction.disabled = false;
            renderNightGrid(playersObj, nightActions, currentStep, isMyTurnToAct);

            if (clientState.myRole === ROLES.MAFIA && currentStep === 'MAFIA') {
              await update(ref(db, `rooms/${clientState.roomCode}/nightActions`), {
                [clientState.myPlayerId]: p.id
              });
            }
          });
        }
        nightPlayerGrid.appendChild(card);
      });
    }

    btnSubmitNightAction.addEventListener('click', async () => {
      const targetId = clientState.selectedNightTargetId;
      const currentStep = clientState.currentRoomData.nightStep;
      if (!targetId || !clientState.isAlive) return;

      btnSubmitNightAction.disabled = true;

      if (clientState.myRole === ROLES.POLICE && currentStep === 'POLICE') {
        const targetPlayer = clientState.currentRoomData.players[targetId];
        if (targetPlayer) {
          const isMafia = (targetPlayer.role === ROLES.MAFIA);
          const resultText = isMafia 
            ? `🚨 <b>[${targetPlayer.name}]</b> 님은 <span style="color:var(--danger); font-weight:bold;">마피아</span>입니다!` 
            : `🛡️ <b>[${targetPlayer.name}]</b> 님은 <span style="color:var(--success); font-weight:bold;">선량한 시민</span>입니다.`;
          
          showModal('👮‍♂️ 경찰 수사 결과', resultText);
        }
      }

      await update(ref(db, `rooms/${clientState.roomCode}/nightActions`), {
        [clientState.myPlayerId]: targetId
      });

      await checkAndAdvanceNightStepHostOnly(clientState.currentRoomData);
    });

    btnSkipNightAction.addEventListener('click', async () => {
      if (!clientState.isAlive) return;
      btnSkipNightAction.disabled = true;

      await update(ref(db, `rooms/${clientState.roomCode}/nightActions`), {
        [clientState.myPlayerId]: 'SKIP'
      });

      await checkAndAdvanceNightStepHostOnly(clientState.currentRoomData);
    });

    async function checkAndAdvanceNightStep(data) {
      if (!clientState.isHost) return;
      await checkAndAdvanceNightStepHostOnly(data);
    }

    async function checkAndAdvanceNightStepHostOnly(data) {
      const currentStep = data.nightStep || 'MAFIA';
      const players = Object.values(data.players || {});
      const nightActions = data.nightActions || {};

      let stepDone = false;

      if (currentStep === 'MAFIA') {
        const aliveMafias = players.filter(p => p.isAlive && p.role === ROLES.MAFIA);
        const actedMafias = aliveMafias.filter(m => nightActions[m.id]);
        if (aliveMafias.length === 0 || actedMafias.length >= aliveMafias.length) stepDone = true;
      } else if (currentStep === 'POLICE') {
        const police = players.find(p => p.isAlive && p.role === ROLES.POLICE);
        if (!police || nightActions[police.id]) stepDone = true;
      } else if (currentStep === 'DOCTOR') {
        const doctor = players.find(p => p.isAlive && p.role === ROLES.DOCTOR);
        if (!doctor || nightActions[doctor.id]) stepDone = true;
      } else if (currentStep === 'PRIEST') {
        const priest = players.find(p => p.isAlive && p.role === ROLES.PRIEST);
        if (!priest || nightActions[priest.id]) stepDone = true;
      } else if (currentStep === 'SNIPER') {
        const sniper = players.find(p => p.isAlive && p.role === ROLES.SNIPER);
        if (!sniper || nightActions[sniper.id]) stepDone = true;
      }

      if (stepDone) {
        const currentIndex = NIGHT_STEPS.indexOf(currentStep);
        if (currentIndex < NIGHT_STEPS.length - 1) {
          const nextStep = NIGHT_STEPS[currentIndex + 1];
          await update(ref(db, `rooms/${clientState.roomCode}`), {
            nightStep: nextStep
          });
        } else {
          await concludeNightActions(data, nightActions);
        }
      }
    }

    async function concludeNightActions(data, actions) {
      const players = data.players || {};
      const mafiaVotes = {};
      let doctorTarget = null;
      let priestTarget = null;
      let sniperTarget = null;
      let sniperId = null;

      for (const [pId, tId] of Object.entries(actions)) {
        const p = players[pId];
        if (!p || tId === 'SKIP') continue;
        if (p.role === ROLES.MAFIA) mafiaVotes[tId] = (mafiaVotes[tId] || 0) + 1;
        if (p.role === ROLES.DOCTOR) doctorTarget = tId;
        if (p.role === ROLES.PRIEST) priestTarget = tId;
        if (p.role === ROLES.SNIPER) {
          sniperTarget = tId;
          sniperId = pId;
        }
      }

      let mafiaTarget = null;
      let maxMafiaVotes = -1;
      for (const [tId, cnt] of Object.entries(mafiaVotes)) {
        if (cnt > maxMafiaVotes) {
          maxMafiaVotes = cnt;
          mafiaTarget = tId;
        }
      }

      let deadListThisNight = [];
      let actionReports = [];

      if (mafiaTarget) {
        if (mafiaTarget === doctorTarget) {
          actionReports.push(`🛡️ 의사가 마피아의 습격으로부터 플레이어를 완벽히 치료하여 막아냈습니다!`);
        } else {
          const victim = players[mafiaTarget];
          if (victim && victim.isAlive) {
            deadListThisNight.push({ player: victim, reason: '마피아 습격' });
            actionReports.push(`💀 <b>${victim.name}</b> 님이 마피아의 습격으로 사망했습니다.`);
          }
        }
      }

      if (sniperTarget && sniperId) {
        const targetPlayer = players[sniperTarget];
        const sniperPlayer = players[sniperId];

        if (targetPlayer && targetPlayer.isAlive) {
          if (targetPlayer.role === ROLES.MAFIA) {
            deadListThisNight.push({ player: targetPlayer, reason: '저격수 사살' });
            actionReports.push(`🎯 <b>${targetPlayer.name}</b> 님 - 저격수의 총에 맞아 사살됨`);
          } else {
            deadListThisNight.push({ player: targetPlayer, reason: '저격 오발 사고' });
            deadListThisNight.push({ player: sniperPlayer, reason: '저격 실패 죄책감 자폭' });
            actionReports.push(`💥 <b>${targetPlayer.name}</b> 님 - 저격수 오발 사고 피해 사망`);
            actionReports.push(`💥 <b>${sniperPlayer.name}</b> 님 - 저격 실패 후 자폭`);
          }
        }
      }

      for (const item of deadListThisNight) {
        await update(ref(db, `rooms/${clientState.roomCode}/players/${item.player.id}`), {
          isAlive: false,
          deadReason: item.reason
        });
      }

      if (priestTarget) {
        const resurrected = players[priestTarget];
        if (resurrected && !resurrected.isAlive) {
          await update(ref(db, `rooms/${clientState.roomCode}/players/${resurrected.id}`), {
            isAlive: true,
            deadReason: ''
          });
          actionReports.push(`✨ <b>${resurrected.name}</b> 님 - 성직자가 부활시킴`);
        }
      }

      if (actionReports.length === 0) {
        actionReports.push('🌙 밤사이 특별한 사건 없이 조용히 지나갔습니다.');
      }

      let firstDead = deadListThisNight.length > 0 ? deadListThisNight[0] : null;

      await update(ref(db, `rooms/${clientState.roomCode}`), {
        latestGameEvent: {
          id: 'event_' + Date.now(),
          type: 'MORNING_REPORT',
          deadName: firstDead ? firstDead.player.name : null,
          deadRole: firstDead ? firstDead.player.role : null,
          deadReason: firstDead ? firstDead.reason : null,
          actionReportText: actionReports.join('<br>')
        }
      });

      if (checkWinCondition(data)) return;

      const nextDayCount = (data.dayCount || 1) + 1;
      await update(ref(db, `rooms/${clientState.roomCode}`), {
        status: 'DAY',
        dayCount: nextDayCount,
        dayAnnouncement: `☀️ 밤사이의 일들이 정리되고 새로운 아침이 밝았습니다.`,
        nightActions: null,
        nightStep: 'MAFIA',
        timerEndTime: Date.now() + 30000
      });
    }

    function checkWinCondition(data) {
      const players = Object.values(data.players || {});
      const aliveMafia = players.filter(p => p.isAlive && p.role === ROLES.MAFIA).length;
      const aliveCitizens = players.filter(p => p.isAlive && p.role !== ROLES.MAFIA).length;

      if (aliveMafia === 0) {
        setGameOver(data, '시민 팀 승리!', '모든 마피아가 소탕되어 평화가 찾아왔습니다.', players);
        return true;
      } else if (aliveMafia >= aliveCitizens) {
        setGameOver(data, '마피아 팀 승리!', '마피아 인원이 생존자 수와 같거나 많아졌습니다.', players);
        return true;
      }
      return false;
    }

    async function setGameOver(data, winnerTitle, desc, playersObj) {
      const survivors = Object.values(playersObj || {}).filter(p => p.isAlive).map(p => `${p.name} (${p.role})`).join(', ') || '없음';

      await update(ref(db, `rooms/${clientState.roomCode}`), {
        status: 'END',
        dayAnnouncement: `🎉 <b>게임 종료</b><br>${winnerTitle} - ${desc}`,
        gameOverInfo: {
          id: 'end_' + Date.now(),
          winnerTitle: winnerTitle,
          desc: desc,
          survivorsText: survivors
        }
      });
    }

    function handleEndSync(data) {
      panelDay.style.display = 'flex';
      panelNight.style.display = 'none';
      phaseBadge.textContent = '게임 종료';
      phaseBadge.className = 'badge badge-lobby';

      if (data.dayAnnouncement) {
        dayAnnouncement.innerHTML = data.dayAnnouncement;
      }
      dayStatusGuide.innerHTML = '🏁 게임이 종료되었습니다. 최종 결과를 확인하세요!';
      btnSubmitDayVote.style.display = 'none';
      btnReturnToLobbyDay.style.display = 'block';
    }

    async function resetToLobby() {
      const data = clientState.currentRoomData;
      if (!data) return;

      const updates = {};
      Object.keys(data.players || {}).forEach(pId => {
        updates[`rooms/${clientState.roomCode}/players/${pId}/role`] = null;
        updates[`rooms/${clientState.roomCode}/players/${pId}/isAlive`] = true;
        updates[`rooms/${clientState.roomCode}/players/${pId}/deadReason`] = '';
        updates[`rooms/${clientState.roomCode}/players/${pId}/readyCheck`] = false;
      });
      updates[`rooms/${clientState.roomCode}/status`] = 'LOBBY';
      updates[`rooms/${clientState.roomCode}/dayCount`] = 1;
      updates[`rooms/${clientState.roomCode}/dayVotes`] = null;
      updates[`rooms/${clientState.roomCode}/nightActions`] = null;
      updates[`rooms/${clientState.roomCode}/nightStep`] = 'MAFIA';
      updates[`rooms/${clientState.roomCode}/latestGameEvent`] = null;
      updates[`rooms/${clientState.roomCode}/gameOverInfo`] = null;

      await update(ref(db), updates);
      window.location.reload();
    }

    btnReturnToLobbyDay.addEventListener('click', resetToLobby);
    btnReturnToLobbyHost.addEventListener('click', resetToLobby);
  </script>
</body>
</html>
